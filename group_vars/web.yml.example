steam_key: ZXZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZ
zerossl_key: XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
acme_email: kittyland@gmail.com

smtp:
  # tls required
  enabled: false
  host: smtp.host.com
  port: 587
  username:
  password:
  from_addr: alert@kittyland.com
  from_name: Alerts
  identity: kittyland.com

node_exporter:
  port: 9100

prometheus:
  port: 9090

# Grafana admin credentials. Applied on first install.
metrics_grafana_admin_user: admin
metrics_grafana_admin_password: ""
# Grafana 13+ requires a non-default renderer token (JWT auth). Must match the
# AUTH_TOKEN set on the grafana_image_renderer container. Generate a secret.
metrics_grafana_renderer_token: ""

# Alertmanager Discord contact. Leave empty to disable provisioning it.
metrics_discord_alert_webhook: ""

# Extra static_configs entries appended to the `node` scrape job. Each entry
# has a targets list and optional labels.
#metrics_node_extra_targets:
#  - targets: ["host:9100"]
#    labels: { instance: myhost }

# Optional extra scrape configs appended to the generated prometheus.yml.
# Each entry is a full scrape config mapping.
#metrics_custom_scrape_configs:
#  - job_name: exporter
#    metrics_path: /metrics
#    static_configs:
#      - targets: ["host:9889"]
#        labels: { aaaa: bbbbbbb }

loki:
  port: 3100

syslog:
  port: 1514

promtail:
  port: 9080

grafana:
  allow_sign_up: false
  port: 3000

srcds_watch:
  host: 0.0.0.0
  port: 8877

gbans_web:
  image: ghcr.io/leighmacdonald/gbans:v0.7.9
  owner: 0000000000000000000
  external_url: https://example.com
  http_host: 0.0.0.0
  http_port: 6006
  http_static_path: ./dist/
  http_cookie_key: change_me
  http_cors_origins:
    - "https://kittyland.com"
    - "http://kittyland.com:5173"
  database_dsn: postgresql://gbans:gbans@gbans-postgres/gbans
  database_log_queries: false

tls_configs:
  your_site_name: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

caddy:
  tls_configs:
    your_site_name:
      api_key: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
      email: a@gmail.com
  static:
    fastdl.kittyland.com:
      root: /fastdl
  hosts:
    metrics.kittyland.com:
      address: grafana:3000
      forward: false
      tls_name: your_site_name
    update.kittyland.com:
      address: swp:8181
      forward: true
      tls_name: your_site_name
    kittyland.com:
      address: gbans-service:6006
      forward: false
      tls_name: your_site_name
    www.kittyland2.com:
      address: kittyland2-web:8003
      forward: false
      tls_name: your_site_name
    kittyland2.com:
      address: kittyland2-web:8003
      forward: false
      tls_name: your_site_name

