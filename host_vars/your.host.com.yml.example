timezone: "America/New_York"
srcds_region: 0
# external ip
ip: "1.2.3.4"
# Public address clients query for A2S; required by srcds_query_cache.
# Must be a real IP, never 0.0.0.0 or 127.0.0.1.
srcds_ip_public: "1.2.3.4"
# Answer A2S queries in the kernel with the eBPF query cache daemon.
srcds_query_cache: false
srcds_use_sdr: false
# Enable the TF2 Rubikon physics engine test flag (-rubikon) at server launch.
srcds_rubikon: false
wireguard_addresses:
  - "10.20.30.10/24"
services:
  - name: "Kittyland | 1 | All Maps"
    server_name_short: "Kittyland-1"
    gslt: "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    gbans_key: "yyyyyyyyyyyyyyyyyyyy"
    log_secret: 111111111
    rotation: "all"
    # Appended to sv_tags (or srcds_sv_tags when unset); string or list.
    # sv_tags_extra: "customtag,anothertag"
    pve_mode: true
    srcds_rcon_password: aaaaaaaaaaa
  - name: "Kittyland | 2 | Community"
    server_name_short: "Kittyland-2"
    gslt: "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    gbans_key: "yyyyyyyyyyyyyyyyyyyy"
    log_secret: 22222222
    rotation: "community"
    srcds_rcon_password: bbbbbbbbbb
  - name: "Kittyland | 3 | All Maps"
    server_name_short: "Kittyland-3"
    gslt: "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    gbans_key: "yyyyyyyyyyyyyyyyyyyy"
    log_secret: 333333333
    rotation: "all"
    stopwatch: false
    srcds_rcon_password: ccccccccc
