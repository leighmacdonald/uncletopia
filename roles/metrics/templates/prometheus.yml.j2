global:
  scrape_interval:     15s # By default, scrape targets every 15 seconds.

scrape_configs:
  - job_name: 'prometheus'
    honor_labels: true
    static_configs:
      - targets: ['localhost:9090']
        labels:
          instance: {{ metrics_hostname }}

  - job_name: 'grafana'
    static_configs:
    - targets: ['grafana:{{ grafana.port|default(3000) }}']
      labels:
        instance: {{ metrics_hostname }}

{#  - job_name: wireguard#}
{#    static_configs:#}
{#      - targets: ['{{ metrics_hostname_internal }}:9586']#}

  - job_name: caddy
    static_configs:
      - targets: ['caddy:2019']
        labels:
          instance: {{ metrics_hostname }}

  - job_name: 'docker'
    static_configs:
      - targets: ['{{ metrics_hostname }}:9323']
        labels:
          instance: {{ metrics_hostname }}

  - job_name: 'node'
    static_configs:
{% for hostname, conf in vpn_hosts.items() %}
{# Prometheus cannot reach the local host VPN IP from inside Docker; use the #}
{# container name on caddy_net for the metrics host itself. #}
      - targets: ['{% if conf == metrics_hostname %}node_exporter{% else %}{{ conf }}{% endif %}:{{ node_exporter.port|default(9100) }}']
        labels:
          instance: {{ hostname }}
{% endfor %}
{% for target in metrics_node_extra_targets | default([]) %}
{{ [target] | to_nice_yaml(indent=2, width=1000) | trim | indent(6, true) }}
{% endfor %}

  - job_name: 'srcds'
    scrape_interval:     60s
    static_configs:
      - targets: ['srcds_watch:{{ srcds_watch.port|default(8899) }}']

{# Targets come from tf2 hosts that opted into the eBPF query cache. #}
{% set a2scache_targets = [] %}
{% for hostname, conf in vpn_hosts.items() %}
{% if conf in hostvars and hostvars[conf]['srcds_query_cache'] | default(false) | bool %}
{% set _ = a2scache_targets.append({'targets': [conf ~ ':' ~ (metrics_a2scache_port | string)], 'labels': {'instance': hostname}}) %}
{% endif %}
{% endfor %}
{% if a2scache_targets | length > 0 %}
  - job_name: 'a2scache'
    scrape_interval: 15s
    static_configs: {{ a2scache_targets | to_json }}
{% endif %}

#  - job_name: srcds-proxy
#    scrape_interval: 10s
#    metrics_path: /metrics
#    static_configs:
#      - targets: ['proxy:9000']

  - job_name: postgres
    scrape_interval: 15s
    static_configs:
      - targets: ['gbans-postgres_exporter:9187', 'bd-api-postgres_exporter:9188']

  - job_name: gbans
    scrape_interval: 15s
    metrics_path: /metrics
    static_configs:
      - targets: ['gbans-service:{{ gbans_web.http_port|default(6006) }}']
        labels:
          instance: {{ metrics_hostname }}

  - job_name: process_exporter
    scrape_interval: 15s
    static_configs:
{% for host in groups.get('tf2', []) %}
{# Use the same public instance label as the node job so dashboards can join them. #}
{% set ns = namespace(public=host) %}
{% for public_name, internal in vpn_hosts.items() %}
{% if internal == host %}{% set ns.public = public_name %}{% endif %}
{% endfor %}
      - targets: ['{% if host == metrics_hostname %}process_exporter{% else %}{{ vpn_ip[host] }}{% endif %}:9256']
        labels:
          instance: {{ ns.public }}
{% endfor %}

{# Optional user-supplied scrape configs (metrics_custom_scrape_configs). #}
{% for scrape_config in metrics_custom_scrape_configs | default([]) %}
{{ [scrape_config] | to_nice_yaml(indent=2, width=1000) | trim | indent(2, true) }}
{% endfor %}
