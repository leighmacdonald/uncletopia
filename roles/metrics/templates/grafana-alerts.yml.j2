---
apiVersion: 1

groups:
  - orgId: 1
    name: a2scache
    folder: a2scache
    interval: 1m
    rules:
      - uid: a2scache-high-drop-rate
        title: A2SCacheHighDropRate
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: prometheus
            model:
              datasource:
                type: prometheus
                uid: prometheus
              editorMode: code
              expr: sum by (instance) (rate(a2scache_bpf_events_total{job="a2scache",stat=~"dropped_.*"}[5m]))
              instant: true
              interval: ""
              intervalMs: 15000
              legendFormat: __auto
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: B
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params:
                      - {{ metrics_a2scache_drop_rate_limit }}
                    type: gt
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
              type: threshold
        noDataState: NoData
        execErrState: Error
        for: 2m
        labels:
          severity: warning
        annotations:
          summary: "a2scache drop rate >{{ metrics_a2scache_drop_rate_limit }} req/s on {% raw %}{{ $labels.instance }}{% endraw %}"
          description: "The eBPF A2S query cache has been dropping more than {{ metrics_a2scache_drop_rate_limit }} queries/s for 2m. Check for an A2S query flood or cache/backend health issues."

  - orgId: 1
    name: node-disk
    folder: Alerts
    interval: 1m
    rules:
      - uid: node-disk-usage-warning
        title: NodeDiskUsageWarning
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: prometheus
            model:
              datasource:
                type: prometheus
                uid: prometheus
              editorMode: code
              expr: 100 * (1 - node_filesystem_avail_bytes{fstype!="tmpfs",mountpoint!~"/etc/.*"} / node_filesystem_size_bytes{fstype!="tmpfs",mountpoint!~"/etc/.*"})
              instant: true
              interval: ""
              intervalMs: 15000
              legendFormat: __auto
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: B
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params:
                      - {{ metrics_disk_warning_percent }}
                    type: gt
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
              type: threshold
        noDataState: NoData
        execErrState: Error
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Disk usage >{{ metrics_disk_warning_percent }}% on {% raw %}{{ $labels.instance }}{% endraw %}"
          description: "{% raw %}{{ $labels.mountpoint }}{% endraw %} is over {{ metrics_disk_warning_percent }}% full on {% raw %}{{ $labels.instance }}{% endraw %}."

      - uid: node-disk-usage-urgent
        title: NodeDiskUsageUrgent
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: prometheus
            model:
              datasource:
                type: prometheus
                uid: prometheus
              editorMode: code
              expr: 100 * (1 - node_filesystem_avail_bytes{fstype!="tmpfs",mountpoint!~"/etc/.*"} / node_filesystem_size_bytes{fstype!="tmpfs",mountpoint!~"/etc/.*"})
              instant: true
              interval: ""
              intervalMs: 15000
              legendFormat: __auto
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: B
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params:
                      - {{ metrics_disk_critical_percent }}
                    type: gt
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
              type: threshold
        noDataState: NoData
        execErrState: Error
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Disk usage >{{ metrics_disk_critical_percent }}% on {% raw %}{{ $labels.instance }}{% endraw %}"
          description: "URGENT: {% raw %}{{ $labels.mountpoint }}{% endraw %} is over {{ metrics_disk_critical_percent }}% full on {% raw %}{{ $labels.instance }}{% endraw %}."

  - orgId: 1
    name: node-cpu
    folder: Alerts
    interval: 1m
    rules:
      - uid: node-cpu0-saturated
        title: NodeCPU0Saturated
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: prometheus
            model:
              datasource:
                type: prometheus
                uid: prometheus
              editorMode: code
              expr: 100 * (1 - rate(node_cpu_seconds_total{cpu="0",mode="idle"}[5m]))
              instant: true
              interval: ""
              intervalMs: 15000
              legendFormat: __auto
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: B
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params:
                      - {{ metrics_cpu0_full_percent }}
                    type: gt
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
              type: threshold
        noDataState: NoData
        execErrState: Error
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: "CPU core 0 saturated for 30m on {% raw %}{{ $labels.instance }}{% endraw %}"
          description: "Core 0 has been over {{ metrics_cpu0_full_percent }}% used for 30m on {% raw %}{{ $labels.instance }}{% endraw %}. Other cores being busy does not trigger this alert."

  - orgId: 1
    name: node-availability
    folder: Alerts
    interval: 1m
    rules:
      - uid: node-metrics-down
        title: NodeMetricsDown
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: prometheus
            model:
              datasource:
                type: prometheus
                uid: prometheus
              editorMode: code
              expr: up{job="node"} == 0
              instant: true
              interval: ""
              intervalMs: 15000
              legendFormat: __auto
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: B
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params:
                      - 0
                    type: gt
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
              type: threshold
        # A missing series (scrape target gone entirely) is also a down host.
        noDataState: Alerting
        execErrState: Error
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Node stopped reporting metrics on {% raw %}{{ $labels.instance }}{% endraw %}"
          description: "node_exporter has been down or absent for 2m on {% raw %}{{ $labels.instance }}{% endraw %}."

  - orgId: 1
    name: node-runqueue
    folder: Alerts
    interval: 1m
    rules:
      - uid: node-runqueue-high
        title: NodeRunqueueHigh
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: prometheus
            model:
              datasource:
                type: prometheus
                uid: prometheus
              editorMode: code
              # node_cpu_isolated only has series for isolated CPUs; the rest are non-isolated.
              expr: >-
                node_procs_running / on(instance) clamp_min(
                  count by (instance) (node_cpu_seconds_total{mode="idle"})
                    - count by (instance) (node_cpu_isolated), 1)
              instant: true
              interval: ""
              intervalMs: 15000
              legendFormat: __auto
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: B
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params:
                      - {{ metrics_runqueue_per_cpu_limit }}
                    type: gt
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
              type: threshold
        noDataState: NoData
        execErrState: Error
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High runqueue per non-isolated CPU on {% raw %}{{ $labels.instance }}{% endraw %}"
          description: "Runqueue per non-isolated CPU has been above {{ metrics_runqueue_per_cpu_limit }} for 5m on {% raw %}{{ $labels.instance }}{% endraw %}. Isolated CPUs are excluded."

  - orgId: 1
    name: node-memory
    folder: Alerts
    interval: 1m
    rules:
      - uid: node-memory-low-warning
        title: NodeMemoryLowWarning
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: prometheus
            model:
              datasource:
                type: prometheus
                uid: prometheus
              editorMode: code
              expr: 100 * node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes
              instant: true
              interval: ""
              intervalMs: 15000
              legendFormat: __auto
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: B
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params:
                      - {{ metrics_memory_free_warning_percent }}
                    type: lt
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
              type: threshold
        noDataState: NoData
        execErrState: Error
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Available memory below {{ metrics_memory_free_warning_percent }}% on {% raw %}{{ $labels.instance }}{% endraw %}"
          description: "Available memory has been under {{ metrics_memory_free_warning_percent }}% for 5m on {% raw %}{{ $labels.instance }}{% endraw %}."

      - uid: node-memory-low-urgent
        title: NodeMemoryLowUrgent
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: prometheus
            model:
              datasource:
                type: prometheus
                uid: prometheus
              editorMode: code
              expr: 100 * node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes
              instant: true
              interval: ""
              intervalMs: 15000
              legendFormat: __auto
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: B
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params:
                      - {{ metrics_memory_free_critical_percent }}
                    type: lt
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
              type: threshold
        noDataState: NoData
        execErrState: Error
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Available memory below {{ metrics_memory_free_critical_percent }}% on {% raw %}{{ $labels.instance }}{% endraw %}"
          description: "URGENT: available memory has been under {{ metrics_memory_free_critical_percent }}% for 2m on {% raw %}{{ $labels.instance }}{% endraw %}."

  - orgId: 1
    name: node-network
    folder: Alerts
    interval: 1m
    rules:
      - uid: node-network-packet-drops
        title: NodeNetworkPacketDrops
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: prometheus
            model:
              datasource:
                type: prometheus
                uid: prometheus
              editorMode: code
              expr: >-
                sum by (instance, device) (
                  rate(node_network_receive_drop_total{device!~"lo|veth.*|docker.*|br-.*|tailscale.*"}[5m])
                  + rate(node_network_transmit_drop_total{device!~"lo|veth.*|docker.*|br-.*|tailscale.*"}[5m]))
              instant: true
              interval: ""
              intervalMs: 15000
              legendFormat: __auto
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: B
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params:
                      - {{ metrics_network_drop_rate_limit }}
                    type: gt
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
              type: threshold
        noDataState: NoData
        execErrState: Error
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High packet drops on {% raw %}{{ $labels.device }}{% endraw %} at {% raw %}{{ $labels.instance }}{% endraw %}"
          description: "{% raw %}{{ $labels.device }}{% endraw %} has been dropping more than {{ metrics_network_drop_rate_limit }} packets/s for 5m on {% raw %}{{ $labels.instance }}{% endraw %}."

      - uid: node-network-interface-errors
        title: NodeNetworkInterfaceErrors
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: prometheus
            model:
              datasource:
                type: prometheus
                uid: prometheus
              editorMode: code
              expr: >-
                sum by (instance, device) (
                  rate(node_network_receive_errs_total{device!~"lo|veth.*|docker.*|br-.*|tailscale.*"}[5m])
                  + rate(node_network_transmit_errs_total{device!~"lo|veth.*|docker.*|br-.*|tailscale.*"}[5m]))
              instant: true
              interval: ""
              intervalMs: 15000
              legendFormat: __auto
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: B
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params:
                      - {{ metrics_network_error_rate_limit }}
                    type: gt
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
              type: threshold
        noDataState: NoData
        execErrState: Error
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Interface errors on {% raw %}{{ $labels.device }}{% endraw %} at {% raw %}{{ $labels.instance }}{% endraw %}"
          description: "{% raw %}{{ $labels.device }}{% endraw %} has been reporting more than {{ metrics_network_error_rate_limit }} errors/s for 5m on {% raw %}{{ $labels.instance }}{% endraw %}."

      - uid: node-network-link-down
        title: NodeNetworkLinkDown
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: prometheus
            model:
              datasource:
                type: prometheus
                uid: prometheus
              editorMode: code
              expr: node_network_up{device!~"lo|veth.*|docker.*|br-.*|tailscale.*"} == 0
              instant: true
              interval: ""
              intervalMs: 15000
              legendFormat: __auto
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: B
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params:
                      - 0
                    type: gt
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
              type: threshold
        noDataState: NoData
        execErrState: Error
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Link down on {% raw %}{{ $labels.device }}{% endraw %} at {% raw %}{{ $labels.instance }}{% endraw %}"
          description: "{% raw %}{{ $labels.device }}{% endraw %} operstate has been down for 2m on {% raw %}{{ $labels.instance }}{% endraw %}."

  - orgId: 1
    name: srcds
    folder: Alerts
    interval: 1m
    rules:
      - uid: srcds-32bit-memory-high
        title: SrcDS32BitMemoryHigh
        condition: B
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: prometheus
            model:
              datasource:
                type: prometheus
                uid: prometheus
              editorMode: code
              expr: namedprocess_namegroup_memory_bytes{memtype="resident",groupname=~"srcds.*"}
              instant: true
              interval: ""
              intervalMs: 15000
              legendFormat: __auto
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: B
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator:
                    params:
                      - {{ metrics_srcds_memory_limit_bytes }}
                    type: gt
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: __expr__
              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
              type: threshold
        noDataState: NoData
        execErrState: Error
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "srcds approaching 32-bit memory limit on {% raw %}{{ $labels.instance }}{% endraw %}"
          description: "{% raw %}{{ $labels.groupname }}{% endraw %} RSS has been above {{ metrics_srcds_memory_limit_bytes }} bytes (3 GiB) for 5m on {% raw %}{{ $labels.instance }}{% endraw %}. The 32-bit address space limit is ~4 GiB."

{# No contact point or policy is provisioned when the webhook is empty, leaving Grafana's defaults. #}
{% if metrics_discord_alert_webhook | default('') | trim | length > 0 %}
contactPoints:
  - orgId: 1
    name: discord
    receivers:
      - uid: discord
        type: discord
        settings:
          url: {{ metrics_discord_alert_webhook }}

policies:
  - orgId: 1
    receiver: discord
    group_by: ['alertname', 'instance']
    group_wait: 30s
    group_interval: 5m
    repeat_interval: 4h
{% endif %}
