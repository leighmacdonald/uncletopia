[Unit]
Description=srcds-{{ item.server_name_short }}
PartOf=srcds-master.service
After=network.target {{ srcds_mount_units[item.server_name_short] }}
Requires={{ srcds_mount_units[item.server_name_short] }}

[Service]
Type=forking
User={{ srcds_user }}
Group=tf2
Nice=-5

{% if srcds_pin_cpus | default(false) | bool %}
CPUAffinity={{ srcds_game_cores[loop0] | join(',') }}
{% endif %}

WorkingDirectory=/home/{{ srcds_user }}/srcds-{{ item.server_name_short }}
Environment=

RemainAfterExit=yes
User={{ srcds_user }}
ExecStart=/usr/bin/tmux -S ./tmux.sock new-session -s {{ item.server_name_short }} -d ./entry.sh
ExecStop=/usr/bin/bash ./stop.sh

KillSignal=SIGCONT

TimeoutStartSec=0

# Use larger timeouts since we have a restart script that notifies
# users and winds the game down in a couple mins.
TimeoutStopSec=300
TimeoutSec=300

Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
