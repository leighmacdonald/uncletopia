[Unit]
Description=srcds-{{ item.server_name_short }}
PartOf=srcds-master.service
After=network.target {{ srcds_mount_units[item.server_name_short] }}
Requires={{ srcds_mount_units[item.server_name_short] }}

[Service]
Type=forking
User={{ srcds_user }}
Group=tf2
Nice=-5

{% if srcds_pin_cpus | default(false) | bool %}
CPUAffinity={{ srcds_game_cores[loop0] | join(',') }}
{% endif %}

WorkingDirectory=/home/{{ srcds_user }}/srcds-{{ item.server_name_short }}
Environment=

RemainAfterExit=yes
User={{ srcds_user }}
ExecStart=/usr/bin/tmux -S ./tmux.sock new-session -s {{ item.server_name_short }} -d ./entry.sh
{% if item.srcds_restart_notice | default(srcds_restart_notice) | bool %}
ExecStop=/usr/bin/bash ./stop.sh
{% else %}
ExecStop=/usr/bin/tmux -S ./tmux.sock send -t {{ item.server_name_short }} "quit" ENTER
{% endif %}

KillSignal=SIGCONT

TimeoutStartSec=0

# Larger timeout for the optional restart-notice sequence in stop.sh.
TimeoutStopSec=300
TimeoutSec=300

Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
