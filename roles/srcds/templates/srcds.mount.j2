[Unit]
Description=Overlay filesystem for srcds-{{ item.server_name_short }}
# Do not add After=local-fs.target here: systemd already orders mount units
# before local-fs.target, and the explicit reverse ordering creates a cycle at
# boot which makes systemd drop the mount jobs (and the srcds services that
# Require= them never start).

[Mount]
What=overlay
Where=/home/{{ srcds_user }}/srcds-{{ item.server_name_short }}
Type=overlay
Options=lowerdir=/home/{{ srcds_user }}/srcds-base,upperdir=/home/{{ srcds_user }}/srcds-{{ item.server_name_short }}-upper,workdir=/home/{{ srcds_user }}/srcds-{{ item.server_name_short }}-work

[Install]
WantedBy=multi-user.target
