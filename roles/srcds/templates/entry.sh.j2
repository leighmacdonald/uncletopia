#!/bin/bash

# Plugin/extension selection is applied at deploy time by the pristine-layout
# task in roles/srcds/tasks/main.yml; nothing is toggled on startup here.

bash "./srcds_run" -game "{{srcds_steam_app}}" -console \
  -strictportbind \
  -usercon \
  -secured \
  {% if item.srcds_rubikon|default(srcds_rubikon) %}-rubikon {% endif %} \
  -port "{{ srcds_base_port + (loop0 * 10) }}" \
  +tv_port "{{ srcds_base_port + (loop0 * 10) + 1 }}" \
  +clientport "{{ srcds_base_port + (loop0 * 10) + 2 }}" \
  {% if item.srcds_max_players|default(srcds_max_players) > 33 %}-unrestricted_maxplayers{% endif %} \
  +maxplayers {{ item.srcds_max_players|default(srcds_max_players) }} \
  +map "{% if item.curated_pool|default("") == "" %}{{ srcds_map_rotation[item.config|default("all")] | random }}{% elif item.curated_pool == "247_badwater"  %}pl_badwater{% else %}{{ srcds_map_rotation[item.curated_pool|default("all")] | random }}{% endif %}" \
  +sv_setsteamaccount "{{ item.gslt }}" \
  +rcon_password "{{ item.srcds_rcon_password | default(srcds_rcon_password) }}" \
  +sv_password "{{ item.srcds_server_password | default(srcds_server_password) }}" \
  +sv_region "{{ srcds_region | quote }}" \
  {% if not item.srcds_use_sdr|default(srcds_use_sdr) and ip != "" %}+ip {{ ip }} {% endif %} \
  {% if item.srcds_use_sdr|default(srcds_use_sdr) %}-enablefakeip {% endif %} \
  {% if srcds_workshop_auth_key %}-authkey "{{ srcds_workshop_auth_key }}"{% endif %}
